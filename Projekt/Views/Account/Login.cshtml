@model LoginViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0);">
                    <h4 class="mb-0">
                        <i class="fas fa-user-lock me-2"></i>
                        Panel logowania
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Login" method="post" class="needs-validation">
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        
                        <div class="mb-4">
                            <label asp-for="Username" class="form-label fw-bold">
                                <i class="fas fa-user me-2"></i>Nazwa użytkownika
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-user text-primary"></i>
                                </span>
                                <input asp-for="Username" class="form-control" placeholder="Wprowadź nazwę użytkownika" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="fas fa-key me-2"></i>Hasło
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-lock text-primary"></i>
                                </span>
                                <input asp-for="Password" class="form-control" placeholder="Wprowadź hasło" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-4 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">
                                <i class="fas fa-cookie me-2"></i>Zapamiętaj mnie
                            </label>
                        </div>
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span>Wystąpił błąd</span>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 py-2 mb-3 btn-gradient">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Zaloguj się
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-gradient {
        background: linear-gradient(45deg, #0d6efd, #0dcaf0);
        border: none;
        transition: all 0.3s ease;
    }
    
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
    }
    
    .card {
        transition: all 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
    }
    
    .input-group-text {
        border: none;
    }
    
    .form-control {
        border: 1px solid #e0e0e0;
    }
    
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 