@{
    ViewData["Title"] = "Strona główna";
}

<div class="container mt-4">
    <div class="jumbotron text-center bg-primary text-white p-5 rounded-3 shadow">
        <h1 class="display-4"><i class="fas fa-film"></i> Baza Filmowa</h1>
        <p class="lead">Witaj w naszej bazie filmowej! Odkryj tysiące filmów, wytwórni i szczegółowych informacji.</p>
    </div>

    <div class="row mt-5 justify-content-center">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-building fa-3x text-primary mb-3"></i>
                    <h3 class="card-title">Wytwórnie Filmowe</h3>
                    <p class="card-text">Przeglądaj listę wytwórni filmowych i ich produkcje.</p>
                    <a asp-controller="ProductionCompanies" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-arrow-right"></i> Przejdź do wytwórni
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-info-circle text-info"></i> O Projekcie</h4>
                    <p class="card-text">
                        Nasza baza filmowa to kompleksowe źródło informacji o filmach, wytwórniach i wszystkim, 
                        co związane z przemysłem filmowym.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title"><i class="fas fa-chart-bar text-success"></i> Statystyki</h4>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-film text-primary"></i> Liczba filmów: <strong>1000+</strong></li>
                        <li><i class="fas fa-building text-secondary"></i> Liczba wytwórni: <strong>100+</strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4 mb-5">
        <p class="text-muted">
            <i class="fas fa-code"></i> Projekt stworzony przez Maciej Karwacik
        </p>
    </div>
</div>